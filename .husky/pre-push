#!/usr/bin/env sh

CURRENT_BRANCH=$(git branch --show-current)

# main — protected, пушить только через PR/merge
if [ "$CURRENT_BRANCH" = "main" ]; then
    echo "❌ main — protected branch"
    echo "   Создай feature/ или Release/ ветку и открой PR"
    exit 1
fi

# Разрешённые форматы: Release/*, feature/*, fix/*
if echo "$CURRENT_BRANCH" | grep -qE "^(Release/|feature/|fix/)"; then
    echo "✅ Ветка: $CURRENT_BRANCH"
    exit 0
fi

echo "❌ Неправильный формат ветки: $CURRENT_BRANCH"
echo "✅ Допустимо: Release/X.Y.Z-desc, feature/#N-desc, fix/#N-desc"
exit 1